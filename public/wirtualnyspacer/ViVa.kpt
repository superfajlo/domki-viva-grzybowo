      <filechooser id="helpscreenfg" uiPreview="false" name="tr:Help screen foreground" customize="false" conditionalValues="false" allowRemote="true" conditionalParam="useThemeHelpScreen" default="" allowEmpty="false" filters="images"/>
     </feature>
     <feature enabled="True" id="hidecontrols" crop="0|0|50|50" uiPreview="false" name="tr:Show/hide controls " customize="false" guiIcon="btn_hide_controls.png" forceEnabled="False">
      <string id="displayControlsTip" uiPreview="false" name="tr:Show controls tooltip" customize="false" conditionalValues="true" staticmessageid="" conditionalParam="tooltips" default="Pokaż elementy sterujace" needTranslation="true"/>
      <string id="hideControlsTip" uiPreview="false" name="tr:Hide controls tooltip" customize="false" conditionalValues="true" staticmessageid="" conditionalParam="tooltips" default="Ukryj elementy sterujące" needTranslation="true"/>
