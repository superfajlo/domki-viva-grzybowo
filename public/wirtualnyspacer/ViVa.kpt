      <string id="ctrlmodeMoveTip" uiPreview="false" name="tr:'Move to' mode tooltip" customize="false" conditionalValues="true" staticmessageid="" conditionalParam="tooltips" default="Zmień tryb sterowania" needTranslation="true"/>
