# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# źródła grafik (opublikowany plik jest w public/)
/assets/hero-source.png
/assets/hero-drone-source.png
/assets/mapa-grzybowo-source.png

# lokalne artefakty (wydarzenia cache są w pamięci /tmp, nie tutaj)
/.cache/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files – hasła tylko lokalnie; .env.example jest w repozytorium
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
