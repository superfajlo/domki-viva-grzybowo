# Skopiuj do .env.local i uzupełnij wartości. Hasła NIE commituj.

# Adres właściciela – odbiorca wiadomości z formularza
CONTACT_TO_EMAIL=viva3@onet.eu

# Konto techniczne SMTP Onet – tylko wysyłka z serwera (nie adres klienta z formularza)
SMTP_HOST=smtp.poczta.onet.pl
SMTP_PORT=587
SMTP_USER=viva3@onet.eu
# Hasło na TEJ SAMEJ linii po znaku = (bez spacji przed hasłem). Po zapisie: npm run check:smtp
SMTP_PASS=

# Publiczny URL strony (SEO, sitemap, Open Graph, Google Search Console)
NEXT_PUBLIC_SITE_URL=https://www.grzybowo-noclegi.pl

# Google Search Console – tylko wartość z content="..." (bez meta tagu)
# GOOGLE_SITE_VERIFICATION=

# Wirtualny spacer: true = proxy na stary hosting; false = pliki z public/ (po install:viva-tour)
VIVA_TOUR_USE_PROXY=true
# VIVA_TOUR_PROXY_ORIGIN=http://www.grzybowo-noclegi.pl
